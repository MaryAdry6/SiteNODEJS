<h2>Pagina Principală</h2>

<div class="descriere">
    <% if (utilizator) { %>
        <p>Bine ai venit, <%= utilizator.Prenume %>!</p>

        <div class="BD">
            <button class="butonBD"><a href="/creare-bd">Creare BD</a></button>
            <br><br>
            <button class="butonBD"><a href="/incarcare-bd">Încarcare BD</a></button>
        </div>

        <br>
        <% if (produse && produse.length > 0) { %>
            <h3>Produse în baza de date:</h3>
            <table>
                <thead>
                    <tr>
                        <th>Nume</th>
                        <th>Firmă</th>
                        <th>Preț</th>
                        <th style="border: none;">  </th>
                    </tr>
                </thead>
                <tbody>
                    <% produse.forEach(function(p) { %>
                        <tr>
                            <td><%= p.nume %></td>
                            <td id="td-firma"><%= p.firma %></td>
                            <td id="td-pret"><%= p.pret %> RON</td>
                            <td style="border: none;">
                                <form action="/adauga-cos" method="POST" style="display:inline;">
                                    <input type="hidden" name="id_produs" value="<%= p.id %>">
                                    <button id="btn-cos" type="submit">
                                        <svg id="cart" fill="#8470C2" width="30px" height="30px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="#8470C2"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#CCCCCC" stroke-width="0.096"></g><g id="SVGRepo_iconCarrier"><path d="M19,14a1,1,0,0,0,.949-.684l2-6A1,1,0,0,0,21,6H7V2A1,1,0,0,0,6,1H3A1,1,0,0,0,3,3H5V17a1,1,0,0,0,1,1H18a1,1,0,0,0,0-2H7V14ZM7,8H19.613l-1.334,4H7ZM6.5,19A1.5,1.5,0,1,1,5,20.5,1.5,1.5,0,0,1,6.5,19Zm10,0A1.5,1.5,0,1,1,15,20.5,1.5,1.5,0,0,1,16.5,19Z"></path></g></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <h3>Baza de date este goală sau nu a fost creată.</h3>
        <% } %>

    <% } else { %>
        <p>Trebuie să te autentifici!</p>
        <a href="/autentificare"><i>Autentificare→</i></a>
    <% } %>
</div>

